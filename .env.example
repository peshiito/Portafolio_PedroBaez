# Clave de Resend (resend.com). Se carga en Vercel como variable de entorno:
# Project Settings > Environment Variables. Nunca llega al navegador.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Casilla donde querés recibir las consultas.
CONTACTO_DESTINO=tu-correo@ejemplo.com

# Remitente. Hasta verificar un dominio propio en Resend, dejá el de prueba;
# con el de prueba sólo podés recibir en la casilla de tu cuenta de Resend.
# Con dominio verificado: "Pedro Baez <hola@pedrobaez.ar>"
CONTACTO_REMITENTE=Portafolio <onboarding@resend.dev>
